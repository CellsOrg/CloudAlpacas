<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>CA Opportunity Agent Access</label>
    <description>Minimum Object/Field access for the Opportunity Agent and its Subagents (Discovery, Activity, Deal Intelligence, Negotiation). Separate from CA_Opportunity_Qualification_Access, for the existing Qualification/Discovery screens.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- Per-User principal access to the Agent API External Credential used by the
         embedded Opportunity Agent chat (OpportunityAgentChatController -> CA_Agent_API_PerUser).
         This enables the assignee to authorize the credential; each user still completes the
         one-time OAuth "Allow" themselves. Without this the callout throws
         "We couldn't access the credential(s)". -->
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>CA_Agent_API_PerUser_Cred-CA_Agent_API_PerUser_Principal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>

    <!-- Agent access (grouped — Metadata API requires all agentAccesses contiguous).
         Without an explicit agentAccesses entry, a non-Admin assignee's requests fail
         before Apex even starts (no ApexLog at all) — confirmed against a real Standard
         User (Manager Lee) in Live Preview testing.
         - Opportunity_Agent hosts the Activity Assistant (activity_management subagent):
           Task/Event query/update/create + get_interaction_intelligence read-back. Needed
           for Manager Lee to reach the agent at all; remove only if the team decides the
           Opportunity Agent is Admin-only.
         - Negotiation_Assistant is Aaron's standalone negotiation agent + its 3 Apex
           actions. -->
    <agentAccesses>
        <agentName>Opportunity_Agent</agentName>
        <enabled>true</enabled>
    </agentAccesses>
    <agentAccesses>
        <agentName>Negotiation_Assistant</agentName>
        <enabled>true</enabled>
    </agentAccesses>

    <!-- Apex class access (grouped — Metadata API requires all classAccesses contiguous).
         - ActivityIntelligenceAgentAction is the Activity Assistant's read-only
           get_interaction_intelligence action (@InvocableMethod). It does not re-query
           anything itself — it calls ActivityIntelligenceController.getIntelligence()
           (with sharing, WITH USER_MODE) and flattens the result for the agent.
         - ConversationHistoryAgentAction is the Activity Assistant's read-only
           get_conversation_history action (@InvocableMethod). Same shape — it calls
           ActivityIntelligenceController.getActivityTimeline() (with sharing,
           WITH USER_MODE, Task/Event/EmailMessage + Interaction Intelligence join,
           email-shadow-task dedupe) and flattens the chronological result. No new SOQL,
           no DML. The II/Signal object + field grants below already cover its reads.
         - ActivityIntelligenceController backs the c:activityTimeline (Interactions tab)
           LWC — getActivityTimeline / getActivityContent / getIntelligence. Without this
           Manager Lee's Interactions component fails to load entirely ("상호작용 내역을
           불러오지 못했습니다"). Read-only controller (with sharing, WITH USER_MODE).
         - NegotiationContext / NegotiationOpportunityLookup / NegotiationTermsUpdater are
           the Negotiation_Assistant's 3 Apex actions (with sharing; USER_MODE / update as
           user).
         - NegotiationContextController is the read-only LWC adapter behind the
           negotiationContextSummary card (Negotiation-stage Opportunity page). It only
           calls NegotiationContext.execute() and flattens the first Result into an
           @AuraEnabled DTO — no new SOQL/DML. Needed for Manager Lee to load the card. -->
    <classAccesses>
        <apexClass>ActivityIntelligenceAgentAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ActivityIntelligenceController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>ConversationHistoryAgentAction</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Activity Assistant: find_activity_attendee. FindActivityAttendee is a read-only
         person-name resolver (@InvocableMethod, with sharing, SOQL WITH USER_MODE, zero
         DML) — resolves a named meeting attendee / task contact to a Contact on the
         Opportunity or its Account, or an active User; its Id binds into create_activity
         whoId so the agent never asks the user for a record Id. -->
    <classAccesses>
        <apexClass>FindActivityAttendee</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NegotiationContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NegotiationContextController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NegotiationOpportunityLookup</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>NegotiationTermsUpdater</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Proposal subagent (Seungwoo / f762840) — 3 Apex actions folded into Opportunity_Agent
         (feature/opportunity-proposal-integration). OpportunityProposalContext (read-only:
         Opportunity B2B fields + converted-Lead segment/score), SponsorshipPackageLookup
         (read-only: active Sponsorship_Package Product2 + standard price), SponsorshipProposalSaver
         (insert as user Quote+QuoteLineItem, update as user Opportunity benefit fields — all
         `with sharing`, USER_MODE). These grants were present in Seungwoo's f762840 permission-set
         version and were lost when PRs #79-#85 redeployed CA_Opportunity_Agent_Access; restored
         here additively. The Proposal subagent is now fully wired into Opportunity_Agent
         (feature/opportunity-proposal-integration): list_sponsorship_packages (menu digest),
         find_sponsorship_package -> FindSponsorshipPackage (deterministic package Id resolver,
         same pattern as NegotiationOpportunityLookup), and save_proposal (existing-Quote
         update / new-Quote create, savepoint-guarded). All four classes are `with sharing`,
         USER_MODE / insert-update as user. -->
    <classAccesses>
        <apexClass>OpportunityProposalContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SponsorshipPackageLookup</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FindSponsorshipPackage</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SponsorshipProposalSaver</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Deal Assistant (deal subagent, feature/opportunity-deal-assistant). DealContext is
         a read-only Opportunity-level snapshot action (@InvocableMethod, `with sharing`,
         all SOQL `WITH USER_MODE`, zero DML). It returns stored facts + threshold-free
         derived date/count values only — no deal-health / risk / win-probability / stalled
         / next-action fields (DealContextTest.testNoJudgementFieldsExist enforces this).
         The LLM synthesis layer in the deal subagent does the interpretation. -->
    <classAccesses>
        <apexClass>DealContext</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Deal Assistant: find_similar_closed_deals action. FindSimilarClosedDeals is a
         read-only Closed Won similarity ranker (@InvocableMethod, `with sharing`, SOQL
         `WITH USER_MODE`, zero DML) — deterministic scoring over stored industry / target
         segment / partner tier / amount band, no AI or predictive score. -->
    <classAccesses>
        <apexClass>FindSimilarClosedDeals</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!-- Embedded Opportunity Agent chat (opportunityAgentChat LWC, feature/opportunity-agent-embedded-chat).
         OpportunityAgentChatController is a transport-only bridge: it relays turns to the
         Opportunity Agent through the Salesforce Agent API, authenticated by the
         CA_Agent_API_PerUser Named Credential — a Per-User OAuth (Browser Flow) External
         Credential (CA_Agent_API_PerUser_Cred). Opportunity_Agent is an internal Employee
         Agent, so it needs a token that represents the running user; each user authorizes
         the External Credential principal (CA_Agent_API_PerUser_Principal) once. The token
         is never handled in Apex or sent to the browser. Zero DML, no deal logic — all
         reasoning stays in the agent and its subagents. This grant only adds the class;
         Per-User principal authorization is done by each user, not via this permission set. -->
    <classAccesses>
        <apexClass>OpportunityAgentChatController</apexClass>
        <enabled>true</enabled>
    </classAccesses>

    <!-- Task / Event / EmailMessage are intentionally NOT listed here as objectPermissions.
         Re-verified 2026-08-29: there is not a single ObjectPermissions row for Task,
         Event, or EmailMessage on any Profile or Permission Set in this org (org-wide
         query returned 0). Salesforce does not expose Activity-family object CRUD through
         the standard ObjectPermissions mechanism — internal users (Standard User profile
         and above) get baseline Task/Event read implicitly. NegotiationContext reads
         Task/Event activity history the same way ActivityIntelligenceController does —
         WITH USER_MODE against the assignee's profile baseline — so no grant is needed
         here, and an explicit block for these is silently dropped on deploy anyway.
         (An earlier iteration of the Negotiation PR added explicit Task/Event Read here;
         removed during the rebase onto main because the org has zero such rows and the
         WITH USER_MODE reads work without them — same as the existing Interactions LWC.) -->

    <!-- Negotiation subagent (Aaron) — Contact/Account read for the primary-contact
         lookup (Decision Context) and for find_opportunity's Account.Name search;
         Quote read+edit to negotiate existing Quote terms (does not create Quotes —
         that stays Proposal/Quote's job); Product2 read because QuoteLineItem's
         Product2/PricebookEntry fields inherit object permissions from Product2/
         Pricebook2/Quote and cannot carry their own objectPermissions entry.
         Does NOT request Pricebook2 or Lead — Negotiation doesn't use them.
         Quote/Product2 may overlap with Proposal/Quote's (Rafael's) own upcoming
         PR for the same objects — expected to merge additively (Create vs. Edit),
         not conflict. -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Contact</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Account</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!-- Quote: read+edit for the Negotiation subagent (update existing Quote terms), plus
         create for the Proposal subagent's save_proposal (SponsorshipProposalSaver does
         `insert as user` on Quote + QuoteLineItem). allowCreate restored from Seungwoo's
         f762840 version (lost in PRs #79-#85). This is the "Create vs. Edit merge additively"
         case the Negotiation comment above anticipated — no conflict. -->
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Quote</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <!-- QuoteLineItem is intentionally NOT listed as objectPermissions. Like the
         Activity family, this org silently drops a QuoteLineItem objectPermissions
         block on deploy (verified 2026-08-29 — retrieved the deployed permission set
         and the block was gone). QuoteLineItem CRUD is controlled by its parent Quote:
         NegotiationContext reads it and NegotiationTermsUpdater does `update as user`
         on the primary line item's Discount, and both succeed for an assignee who can
         see / edit the parent Quote (covered by the Quote read+edit grant above and the
         assignee's sharing access to the Opportunity). If the assignee cannot edit the
         Quote for a given deal, the WITH USER_MODE / update-as-user calls correctly fail
         and the agent reports the failure rather than bypassing access. -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Product2</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Opportunity</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Interaction_Intelligence__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Interaction_Signal__c</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

    <!-- Proposal subagent (Seungwoo / f762840) — read-only object grants, restored from the
         f762840 permission-set version (lost in PRs #79-#85):
         - Lead: OpportunityProposalContext reads the converted Lead (Lead.ConvertedOpportunityId
           back-reference) for its stored Segment Match / Recommendation Reason / Lead Score.
         - Pricebook2: SponsorshipProposalSaver resolves the Standard Price Book
           (SELECT Id FROM Pricebook2 WHERE IsStandard = true) before creating the Quote;
           SponsorshipPackageLookup reads standard-book PricebookEntries via subquery.
         PricebookEntry carries no objectPermissions of its own — it inherits from
         Product2 / Pricebook2 (same parent-controlled pattern as QuoteLineItem above). -->
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Lead</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>Pricebook2</object>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>

