    <decisions>
        <name>Opportunity_Found</name>
        <label>Opportunity Found?</label>
        <locationX>176</locationX>
        <locationY>192</locationY>
        <defaultConnectorLabel>No — end</defaultConnectorLabel>
        <rules>
            <name>Yes_Opportunity_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Open_Tasks_All</targetReference>
            </connector>
            <label>Yes — Opportunity found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Task_Overdue</name>
        <label>Is Task Overdue?</label>
        <locationX>264</locationX>
        <locationY>576</locationY>
        <defaultConnector>
            <targetReference>Increment_Open_Only</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not overdue</defaultConnectorLabel>
        <rules>
            <name>Overdue</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Count_Tasks.ActivityDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_Count_Tasks.ActivityDate</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>Today_Formula</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_Open_And_Overdue</targetReference>
            </connector>
            <label>Overdue</label>
        </rules>
    </decisions>

    <description>Task가 생성/수정될 때, 연결된 Opportunity(WhatId)의 Open Tasks / Overdue Tasks 개수와 가장 가까운 Next Activity(Subject/Date)를 자동으로 계산해서 채워줍니다. Task 삭제는 처리하지 않습니다(향후 필요 시 별도 Delete-트리거 Flow로 확장).</description>
    <environments>Default</environments>

    <formulas>
        <name>Today_Formula</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>

    <interviewLabel>CA Update Opportunity Next Activity {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CA Update Opportunity Next Activity</label>

    <loops>
        <name>Loop_Count_Tasks</name>
        <label>Loop Through Open Tasks</label>
        <locationX>176</locationX>
        <locationY>480</locationY>
        <collectionReference>Get_Open_Tasks_All</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Is_Task_Overdue</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Prepare_Opportunity_Update</targetReference>
        </noMoreValuesConnector>
    </loops>

