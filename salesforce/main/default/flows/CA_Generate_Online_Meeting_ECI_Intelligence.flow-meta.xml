    <decisions>
        <name>Is_Transcript_Processable</name>
        <label>Transcript Has a Safe Canonical Event?</label>
        <locationX>50</locationX>
        <locationY>180</locationY>
        <defaultConnector>
            <targetReference>Safe_End</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unmatched or incomplete — end</defaultConnectorLabel>
        <rules>
            <name>Yes_Processable</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varIsProcessable</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Canonical_Online_Event</targetReference>
            </connector>
            <label>Yes — exact key and Opportunity match</label>
        </rules>
    </decisions>
