<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>

    <assignments>
        <name>Prepare_Last_Contact_Update</name>
        <label>Prepare Last Contact Update</label>
        <locationX>176</locationX>
        <locationY>656</locationY>
        <assignmentItems>
            <assignToReference>Get_Related_Opportunity.Last_Contact_Date__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.EndDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Get_Related_Opportunity.Last_Contact_Type__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Meeting_Contact_Type_Label</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Opportunity_Last_Contact</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Fault_End</name>
        <label>Fault End — log and swallow</label>
        <locationX>400</locationX>
        <locationY>96</locationY>
        <assignmentItems>
            <assignToReference>faultMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>

    <decisions>
        <name>Opportunity_Found</name>
        <label>Opportunity Found?</label>
        <locationX>176</locationX>
        <locationY>192</locationY>
        <defaultConnectorLabel>No — end</defaultConnectorLabel>
        <rules>
            <name>Yes_Opportunity_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Opportunity</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Customer_Participant</targetReference>
            </connector>
            <label>Yes — Opportunity found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Qualifying_Meeting</name>
        <label>Is Qualifying Customer Meeting?</label>
        <locationX>176</locationX>
        <locationY>424</locationY>
        <defaultConnectorLabel>Not qualifying — end</defaultConnectorLabel>
        <rules>
            <name>Qualifying_Meeting</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Customer_Participant</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Meeting_Type__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDateTime</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDateTime</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Is_Newer_Than_Current</targetReference>
            </connector>
            <label>Qualifying (has customer contact, Meeting Type set, already occurred)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Newer_Than_Current</name>
        <label>Is This Meeting Newer Than Current Last Contact?</label>
        <locationX>176</locationX>
        <locationY>536</locationY>
        <defaultConnectorLabel>Not newer — end</defaultConnectorLabel>
        <rules>
            <name>Newer_Or_Blank</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Opportunity.Last_Contact_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EndDateTime</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>Get_Related_Opportunity.Last_Contact_Date__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Prepare_Last_Contact_Update</targetReference>
            </connector>
            <label>Newer or currently blank</label>
        </rules>
    </decisions>

    <description>완료된 고객 Meeting(Opportunity 연결 + EventWhoRelation에 Opportunity와 동일 Account 소속 Contact 참여자 존재 + Meeting_Type__c 지정 + EndDateTime이 과거)이 저장될 때, 연결된 Opportunity의 Last Contact Date/Type을 갱신합니다. 내부 전용 미팅(고객 Contact 없음), 다른 Account 소속 Contact만 참여한 미팅, Meeting Type 미지정, 아직 열리지 않은 미팅은 대상이 아닙니다(Customer Contact 정의). Scheduled Path(EndDateTime 시점)로 레코드 재저장 없이도 미래 등록된 미팅이 종료 후 자동 재평가됩니다. 기존 Last Contact보다 최신인 경우에만 갱신하며(forward-only), 삭제/역행 수정에 대한 재계산은 하지 않습니다.</description>
    <environments>Default</environments>

    <formulas>
        <name>Meeting_Contact_Type_Label</name>
        <dataType>String</dataType>
        <expression>IF(ISPICKVAL({!$Record.Meeting_Type__c}, "Online"), "Online Meeting", "Offline Meeting")</expression>
    </formulas>

    <interviewLabel>CA Update Opportunity Last Contact From Meeting {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CA Update Opportunity Last Contact From Meeting</label>

    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>

    <recordLookups>
        <name>Get_Related_Opportunity</name>
        <label>Get Related Opportunity</label>
        <locationX>176</locationX>
        <locationY>96</locationY>
        <connector>
            <targetReference>Opportunity_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.WhatId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Opportunity</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Customer_Participant</name>
        <label>Get Customer Participant</label>
        <locationX>176</locationX>
        <locationY>312</locationY>
        <connector>
            <targetReference>Is_Qualifying_Meeting</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>EventId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Contact</stringValue>
            </value>
        </filters>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Related_Opportunity.AccountId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EventWhoRelation</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>

    <recordUpdates>
        <name>Update_Opportunity_Last_Contact</name>
        <label>Update Opportunity Last Contact</label>
        <locationX>176</locationX>
        <locationY>744</locationY>
        <faultConnector>
            <targetReference>Fault_End</targetReference>
        </faultConnector>
        <inputReference>Get_Related_Opportunity</inputReference>
    </recordUpdates>

    <start>
        <locationX>176</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Related_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>WhatId</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Event</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>After_Meeting_Ends</name>
            <label>After Meeting Ends</label>
            <offsetNumber>0</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <timeSource>RecordField</timeSource>
            <recordField>EndDateTime</recordField>
            <connector>
                <targetReference>Get_Related_Opportunity</targetReference>
            </connector>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>

    <status>Active</status>

    <variables>
        <name>faultMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
