    <decisions>
        <name>Is_Qualifying_Email</name>
        <label>Is Qualifying Customer Email?</label>
        <locationX>176</locationX>
        <locationY>696</locationY>
        <defaultConnectorLabel>No matching customer contact — end</defaultConnectorLabel>
        <rules>
            <name>Qualifying_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Matching_Customer_Contact</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
